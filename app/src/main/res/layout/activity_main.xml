<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio de sesión. Uso ScrollView para que se pueda bajar si no cabe. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- Contenedor vertical con todo centrado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo de la app -->
        <ImageView
            android:id="@+id/imgLogoLogin"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/desc_logo" />

        <!-- Nombre de la app -->
        <TextView
            android:id="@+id/txtNombreAppLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            style="@style/EstiloTitulo" />

        <!-- Frase de bienvenida -->
        <TextView
            android:id="@+id/txtSubtituloLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_subtitulo"
            style="@style/EstiloSubtitulo" />

        <!-- Campo para el correo -->
        <EditText
            android:id="@+id/edtCorreoLogin"
            style="@style/EstiloCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress" />

        <!-- Campo para la contraseña (se ve con puntos) -->
        <EditText
            android:id="@+id/edtContrasenaLogin"
            style="@style/EstiloCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <!-- Botón para ingresar -->
        <Button
            android:id="@+id/btnIngresarLogin"
            style="@style/EstiloBoton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_ingresar" />

        <!-- Texto para ir a la pantalla de registro -->
        <TextView
            android:id="@+id/txtIrRegistroLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:text="@string/login_ir_registro"
            android:textSize="16sp"
            android:textColor="@color/primario" />

    </LinearLayout>
</ScrollView>
